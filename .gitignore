/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (gizli, asla commit etme)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Sanity
.sanity/
sanity-typegen.ts

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Geçici dosyalar (rapor analizi vb.)
/_*.docx
/_*.zip
/_*.txt
/_*_unpacked/

# Playwright test artifacts (Claude'un screenshot aldığı klasör)
/.playwright-mcp/
/novarampa-*.png
/page-*.png

# OS
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# AGENTS.md ve CLAUDE.md commit edilecek (proje dokümantasyonu)
/scripts/_*.html
