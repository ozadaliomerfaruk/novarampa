# ============================================================
# Nova Rampa — Geliştirme Ortamı Değişkenleri
# ============================================================
# Bu dosyayı `.env.local` olarak kopyala ve değerleri doldur.
# Production'da Vercel'in environment ayarlarına aynı anahtarları gir.

# ----- Sanity CMS -----
# https://www.sanity.io/manage/personal/projects adresinden alın.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Sanity Studio yazma izni için — bir API token oluşturun
# (Editor veya Developer rolü). Sadece sunucu tarafında kullanılır.
SANITY_API_WRITE_TOKEN=

# ----- Resend (form bildirim mailleri) -----
# https://resend.com → API Keys
RESEND_API_KEY=
# Eren'e formdan gelen taleplerin düşeceği adres
CONTACT_RECIPIENT=info@novarampa.com
# Gönderen — domain doğrulanana kadar Resend'in test mail'ini kullanabilirsin
CONTACT_SENDER="Nova Rampa <onboarding@resend.dev>"

# ----- Site URL -----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Analytics (opsiyonel, Vercel deploy edilince otomatik) -----
NEXT_PUBLIC_ENABLE_ANALYTICS=true
